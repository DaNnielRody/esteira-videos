  "cases": [
    {
      "schema_version": "1.0",
      "scene_name": "LinearTransformationStudy",
      "description": "Mostre um plano cartesiano e os vetores da base. Aplique uma transformação linear de cisalhamento mantendo a continuidade dos mesmos vetores. Exiba a fórmula indicada na posição exata.",
      "topics": ["linear_algebra"],
      "expect": {"max_shapes": 200, "latex": [{"tex": "A\\mathbf{x}", "font_size": 48, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "DeterminantAreaStudy",
      "description": "Mostre um quadrado unitário sendo transformado por uma matriz e destaque como sua área muda pelo determinante. Exiba a fórmula indicada na posição exata.",
      "topics": ["linear_algebra"],
      "expect": {"max_shapes": 200, "latex": [{"tex": "\\mathrm{area}=|\\det(A)|", "font_size": 48, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "EigenvectorStudy",
      "description": "Mostre vários vetores sob uma transformação e destaque um autovetor que preserva sua direção enquanto muda de escala. Exiba a fórmula indicada na posição exata.",
      "topics": ["linear_algebra"],
      "expect": {"max_shapes": 200, "latex": [{"tex": "A\\mathbf{v}=\\lambda\\mathbf{v}", "font_size": 48, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "NeuralLayersStudy",
      "description": "Construa uma rede neural em camadas, revele conexões atrás dos neurônios e destaque a propagação de ativações da entrada à saída. Exiba a fórmula indicada na posição exata.",
      "topics": ["neural_networks", "linear_algebra"],
      "expect": {"max_shapes": 300, "latex": [{"tex": "\\mathbf{a}^{(l)}=\\sigma(W\\mathbf{a}^{(l-1)}+\\mathbf{b})", "font_size": 40, "color": "yellow", "x": 0.0, "y": -3.0, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "GradientDescentStudy",
      "description": "Mostre um ponto descendo uma curva de custo em passos sucessivos orientados pelo gradiente. Exiba a fórmula indicada na posição exata.",
      "topics": ["machine_learning", "calculus"],
      "expect": {"max_shapes": 200, "latex": [{"tex": "\\theta\\leftarrow\\theta-\\eta\\nabla L(\\theta)", "font_size": 44, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "LinearRegressionStudy",
      "description": "Mostre pontos de dados, ajuste uma reta e revele os resíduos verticais entre as amostras e o modelo. Exiba a fórmula indicada na posição exata.",
      "topics": ["machine_learning", "linear_algebra"],
      "expect": {"max_shapes": 200, "latex": [{"tex": "\\hat{y}=w x+b", "font_size": 48, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "DiscreteConvolutionStudy",
      "description": "Mostre uma janela de kernel deslizando por uma sequência discreta e produzindo cada valor da convolução por soma ponderada local. Exiba a fórmula indicada na posição exata.",
      "topics": ["convolution", "machine_learning"],
      "expect": {"max_shapes": 300, "latex": [{"tex": "(f*g)[n]=\\sum_k f[k]g[n-k]", "font_size": 42, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "AttentionWeightsStudy",
      "description": "Mostre tokens, matrizes de consulta e chave e uma matriz de atenção cuja opacidade representa os pesos entre tokens. Exiba a fórmula indicada na posição exata.",
      "topics": ["transformers", "machine_learning", "linear_algebra"],
      "expect": {"max_shapes": 400, "latex": [{"tex": "\\mathrm{softmax}(QK^T/\\sqrt{d})V", "font_size": 42, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "BayesianUpdateStudy",
      "description": "Mostre uma distribuição a priori sendo atualizada por evidência até se tornar a posterior, mantendo rótulos consistentes. Exiba a fórmula indicada na posição exata.",
      "topics": ["probability", "machine_learning"],
      "expect": {"max_shapes": 300, "latex": [{"tex": "P(H|E)=\\frac{P(E|H)P(H)}{P(E)}", "font_size": 42, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    },
    {
      "schema_version": "1.0",
      "scene_name": "FourierFeaturesStudy",
      "description": "Mostre uma função sendo aproximada por somas parciais de senos e destaque o refinamento a cada novo termo. Exiba a fórmula indicada na posição exata.",
      "topics": ["fourier", "machine_learning"],
      "expect": {"max_shapes": 300, "latex": [{"tex": "f(x)\\approx\\sum_{k=1}^{N}a_k\\sin(kx)", "font_size": 42, "color": "yellow", "x": 0.0, "y": -2.8, "min_iou": 0.95}]}
    }
  ]
